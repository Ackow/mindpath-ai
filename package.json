{
  "name": "ai-learning-map",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-graph.mjs && next build",
    "start": "next start",
    "cf:build": "npm run build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "next lint",
    "generate:graph": "node scripts/generate-graph.mjs",
    "validate:content": "npm run generate:graph && node scripts/validate-content.mjs"
  },
  "overrides": {
    "next-mdx-remote": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.9",
    "lucide-react": "^0.475.0",
    "next": "^15.5.22",
    "next-mdx-remote": "^4.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^20.11.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wrangler": "^4.118.0"
  }
}
